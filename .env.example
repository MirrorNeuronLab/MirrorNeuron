# Runtime environment: dev, test, prod, production
MN_ENV=dev

# Base application directory
MN_HOME=~/.mirrorneuron

# Logging
MN_LOG_LEVEL=info

# API / gRPC
MN_API_HOST=127.0.0.1
MN_API_PORT=8000
MN_CORE_HOST=localhost
MN_GRPC_PORT=50051
MN_GRPC_AUTH_TOKEN=
# MN_GRPC_AUTH_TOKEN_FILE=/run/secrets/mn_grpc_auth_token

# Shared LiteLLM inference queue
MN_LITELLM_MAX_CONCURRENT_REQUESTS=1
MN_LITELLM_MAX_CONCURRENT_EMBEDDINGS=1
MN_LITELLM_MAX_QUEUED_REQUESTS=64
MN_LITELLM_QUEUE_TIMEOUT_SECONDS=1800
MN_LITELLM_MAX_SLOT_SECONDS=3600

# Redis
MN_REDIS_HOST=localhost
MN_REDIS_URL=redis://localhost:6379/0
MN_REDIS_NAMESPACE=mirror_neuron
MN_REDIS_HA_MODE=single
MN_REDIS_SENTINELS=
MN_REDIS_SENTINEL_MASTER=mirror-neuron
MN_REDIS_SENTINEL_HOST_MAP=
MN_REDIS_DB=0
MN_REDIS_USERNAME=
MN_REDIS_PASSWORD=
MN_REDIS_SENTINEL_USERNAME=
MN_REDIS_SENTINEL_PASSWORD=
MN_REDIS_WAIT_REPLICAS=0
MN_REDIS_WAIT_TIMEOUT_MS=100
MN_REDIS_RECONNECT_ATTEMPTS=10
MN_REDIS_RECONNECT_BACKOFF_MS=250
MN_REDIS_RECONNECT_MAX_BACKOFF_MS=2000

# Runtime behavior
MN_TEMP_DIR=/tmp/mirror_neuron
MN_OPENSHELL_BIN=openshell
MN_RECOVERY_EVAL_TTL_SECONDS=86400
MN_JOB_LEASE_DURATION_MS=60000
MN_JOB_LEASE_RENEW_INTERVAL_MS=10000
MN_JOB_SNAPSHOT_INTERVAL_MS=0
MN_JOB_CALL_TIMEOUT_MS=15000
MN_CANCEL_JOB_CALL_TIMEOUT_MS=5000
MN_MESSAGE_DEFAULT_TTL_SECONDS=86400
MN_MESSAGE_MAX_TTL_SECONDS=604800
MN_MESSAGE_ACK_RECEIPT_TTL_SECONDS=3600
MN_MESSAGE_STREAM_TTL_SECONDS=604800
MN_MESSAGE_MAX_PENDING_PER_AGENT=10000
MN_MESSAGE_MAX_PENDING_PER_JOB=100000
MN_MESSAGE_ACK_TIMEOUT_MS=30000
MN_MESSAGE_LEASE_RENEW_MS=10000
MN_MESSAGE_DELIVERY_MAX_ATTEMPTS=10
MN_MESSAGE_DELIVERY_POLL_MS=1000
MN_RELIABILITY_STRATEGY=auto
MN_CLUSTER_HEALTH_STABLE_MS=10000
MN_RELIABILITY_OBSERVER_INTERVAL_MS=5000
MN_NODE_RECONNECT_ATTEMPTS=3
MN_NODE_RECONNECT_BACKOFF_MS=1000

# Clustering / network-only nodes
MN_NODE_ROLE=runtime
MN_NODE_NAME=
MN_CLUSTER_NODES=
MN_COOKIE=
MN_NETWORK_ONLY=false
MN_NETWORK_JOIN_TOKEN=
MN_NETWORK_ADVERTISE_HOST=
MN_NETWORK_REDIS_HOST=
MN_NETWORK_REDIS_PORT=
MN_DIST_PORT=4370

# Node capabilities and execution profiles
MN_NODE_EXECUTION_PROFILES=
MN_NODE_CAPABILITIES=
MN_NODE_GPU=
MN_NODE_DISPLAY_NAME=
MN_NODE_GPU_COUNT=
MN_NODE_CPU_MODEL=
MN_NODE_GPU_NAME=
MN_NODE_GPU_VENDOR=
MN_NODE_GPU_DRIVER=
MN_NODE_GPU_TYPE=
MN_NODE_GPU_API_VERSION=
MN_NODE_GPU_DRIVER_VERSION=
MN_NODE_HOST_PATHS=
MN_NODE_RUNTIME_DRIVERS=
MN_EXECUTION_PROFILES_JSON=

# Bundles and catalogs
MN_MODEL_CATALOG_PATH=
MN_BUNDLES_DIR=
MN_BUNDLE_CACHE_DIR=
MN_BUNDLE_ARCHIVE_MAX_BYTES=
MN_BUNDLE_RELOAD_MODE=
MN_BUNDLE_RELOAD_INTERVAL_SECONDS=

# Resource admission
MN_RESOURCE_ADMISSION_ENABLED=true
MN_MAX_CPU_LOAD_RATIO=
MN_MAX_MEMORY_USED_RATIO=
MN_MAX_GPU_UTILIZATION_RATIO=
MN_MAX_GPU_MEMORY_USED_RATIO=
MN_MAX_COMMAND_LENGTH=32768
MN_MAX_EVENT_BYTES=
MN_MAX_ARTIFACT_BYTES=1048576
MN_MAX_FAN_OUT=

# Local runners
MN_DOCKER_BIN=docker
MN_DOCKER_WORKER_ENABLED=
MN_DOCKER_WORKER_NETWORK=
MN_DOCKER_WORKER_BUILDKIT=
# Defaults to ~/.mn/cache/blueprint-python-envs on each node.
MN_BLUEPRINT_PYTHON_ENVS_DIR=
MN_BLUEPRINT_PYTHON_ENV_SETUP_TIMEOUT_MS=600000
MN_SKILLS_ROOT=
MN_WORKSPACE_ROOT=

# Artifact and shared storage
MN_BLOB_STORE_ROOT=~/.mn/blobs
MN_JOB_ARTIFACT_ROOT=~/.mn/jobs
MN_SHARED_STORAGE_ROOT=~/.mn/shared
# Defaults to ~/.mn/checkpoints on each node. Redis remains the recovery authority.
MN_CHECKPOINT_ROOT=
MN_HOST_SHARED_STORAGE_ROOT=
MN_RUNTIME_SHARED_STORAGE_ROOT=
MN_SYNCTHING_RESCAN_INTERVAL_SECONDS=3600
