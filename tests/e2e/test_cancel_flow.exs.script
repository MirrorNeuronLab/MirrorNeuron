defmodule TestCancel do
  def run do
    job_id = "dmv-2e6d048a"
    result = {:error, "job #{job_id} is not running in the connected cluster"}
    case result do
      {:error, "job " <> _ = reason} -> IO.puts("MATCHED: #{reason}")
      _ -> IO.puts("NO MATCH")
    end
  end
end

TestCancel.run()
