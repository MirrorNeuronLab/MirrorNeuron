defmodule TestFetchJob do
  def run do
    # Create the job exactly as it would be created
    job_id = "test-job-1"
    raw_manifest = %{
      "graph_id" => "graph-1",
      "job_name" => "Test Job",
      "daemon" => false,
      "entrypoints" => ["root"],
      "initial_inputs" => %{"root" => [%{"message" => "hello"}]},
      "nodes" => [%{"node_id" => "root", "agent_type" => "router", "type" => "map"}],
      "edges" => [],
      "policies" => %{},
      "manifest_version" => "1.0"
    }

    {:ok, manifest} = MirrorNeuron.Manifest.load(raw_manifest)
    {:ok, ^job_id, _pid} = MirrorNeuron.Runtime.start_job(manifest, job_id: job_id)
    
    # Wait a sec
    Process.sleep(100)
    
    case MirrorNeuron.Persistence.RedisStore.fetch_job(job_id) do
      {:ok, job} -> 
        IO.inspect(job, label: "Fetched Job")
        IO.inspect(job["status"], label: "Status")
        unless job["status"] in ["pending", "running", "paused"] do
          raise "expected active job status, got #{inspect(job["status"])}"
        end
      other -> 
        raise "expected to fetch job #{job_id}, got #{inspect(other)}"
    end
  end
end
TestFetchJob.run()
